#!/bin/bash
# 
# Last Updated: Fri May 01,2026
#
## BEGIN Custom Aliases - Base ##
alias ll='ls -hl --color=auto'
alias rm='rm -i'
alias mv='mv -v'
alias cp='cp -v'
#
# DOS-Like commands
alias md='mkdir'
alias rd='rmdir'
#
# Systemctl Aliases
alias sc='systemctl'
alias scs='systemctl status'
alias scstart='systemctl start'
alias scstop='systemctl stop'
#
# Interactive
alias rmi='rm -i'
alias cpi='cp -i'
alias mvi='mv -i'
#
# Archive extraction
alias untar='tar -xvf'
alias ungz='tar -xzvf'
alias unbz2='tar -xjvf'
#
# Disk usage
alias biggest='du -h --max-depth=1 | sort -h'
#
# Time 
alias now='date +"%d-%m-%Y %I:%M %p"'
alias today='date +"%Y%m%d"'
#
# Other
alias sensors='sensors -f'
#
## END Custom Aliases ##
